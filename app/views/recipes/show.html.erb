<div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-md overflow-hidden border border-gray-100 my-6">
  
  <div class="md:flex">
    
    <div class="md:w-1/2 h-72 md:h-auto bg-gray-100 flex items-center justify-center relative">
      <% if @recipe.image.attached? %>
        <%= image_tag @recipe.image, class: "w-full h-full object-cover" %>
      <% else %>
        <div class="text-center p-6 text-gray-400">
          <span class="text-5xl block mb-3">🍷</span>
          <span class="text-sm font-medium">料理の画像は未登録です</span>
        </div>
      <% end %>
    </div>

    <div class="p-8 md:w-1/2 flex flex-col justify-between bg-white">
      <div>
        <div class="flex flex-wrap gap-2 mb-4">
          <% wine_color = case @recipe.wine_type when 'red' then 'bg-red-50 text-red-800 border-red-200' when 'white' then 'bg-amber-50 text-amber-700 border-amber-200' else 'bg-pink-50 text-pink-800 border-pink-200' end %>
          <span class="text-xs font-bold px-3 py-1 rounded-full border <%= wine_color %>">
            <%= {'red' => '🍷 赤ワイン', 'white' => '🥂 白ワイン', 'rose' => '🌸 ロゼワイン'}[@recipe.wine_type] %>
          </span>

          <% body_color = case @recipe.wine_body when 'light' then 'bg-emerald-50 text-emerald-700 border-emerald-200' when 'medium' then 'bg-yellow-50 text-yellow-800 border-yellow-200' else 'bg-purple-50 text-purple-800 border-purple-200' end %>
          <span class="text-xs font-bold px-3 py-1 rounded-full border <%= body_color %>">
            <%= {'light' => '🍃 ライト', 'medium' => '🪵 ミディアム', 'full' => '🪵 フルボディ'}[@recipe.wine_body] %>
          </span>
        </div>

        <h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4"><%= @recipe.title %></h1>
        
        <div class="flex flex-wrap gap-1.5 mb-6">
          <% @recipe.tags.each do |tag| %>
            <span class="bg-gray-100 text-gray-600 px-2.5 py-1 rounded-md text-xs font-medium">#<%= tag.name %></span>
          <% end %>
        </div>
      </div>

      <div class="mt-6 md:mt-0">
        <% if logged_in? %>
          <% if current_user.bookmark?(@recipe) %>
            <%= link_to bookmarks_path(recipe_id: @recipe.id), data: { turbo_method: :delete }, class: "w-full text-center inline-block bg-amber-500 text-white font-semibold py-3 px-4 rounded-xl shadow-sm hover:bg-amber-600 transition duration-300" do %>
              ★ お気に入りを解除する
            <% end %>
          <% else %>
            <%= link_to bookmarks_path(recipe_id: @recipe.id), data: { turbo_method: :post }, class: "w-full text-center inline-block bg-white text-amber-600 border-2 border-amber-500 font-semibold py-2.5 px-4 rounded-xl shadow-sm hover:bg-amber-50 transition duration-300" do %>
              ☆ お気に入りに追加する
            <% end %>
          <% end %>
        <% else %>
          <p class="text-xs text-center text-gray-400 bg-gray-50 py-3 rounded-xl border border-dashed border-gray-200">
            <%= link_to 'ログイン', login_path, class: "text-red-800 underline font-medium" %>するとお気に入り機能が使えます
          </p>
        <% end %>
      </div>

    </div>
  </div>

  <div class="p-8 border-t border-gray-100 bg-gray-50/70">
    <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
      <span class="mr-2 bg-red-800 text-white w-6 h-6 rounded-full flex items-center justify-center text-xs">✨</span>
      マリアージュのポイント・おすすめの理由
    </h2>
    <div class="text-gray-600 leading-relaxed whitespace-pre-wrap text-sm md:text-base bg-white p-5 rounded-xl border border-gray-200/60 shadow-inner">
      <%= @recipe.description %>
    </div>
  </div>

</div>

<div class="max-w-4xl mx-auto flex flex-col sm:flex-row justify-between items-center px-4 mb-12 gap-4">
  <div class="flex items-center space-x-6">
    <%= link_to 'javascript:history.back()', class: "text-sm text-gray-500 hover:text-gray-800 font-medium transition flex items-center gap-1" do %>
      <span>←</span> 戻る
    <% end %>
    <%= link_to 'トップページへ', root_path, class: "text-sm text-gray-500 hover:text-gray-800 font-medium transition underline" %>
  </div>

  <% if current_user&.admin? %>
    <%= link_to edit_recipe_path(@recipe), class: "text-xs bg-gray-800 text-gray-200 px-4 py-2 rounded-lg hover:bg-gray-700 hover:text-white transition shadow-sm flex items-center gap-1" do %>
      <span>🛠</span> 管理者用メニュー：画像をアップロードする
    <% end %>
  <% end %>
</div>