<div style="text-align: center; margin-top: 50px;">
  <h2><%= @recipe.title %></h2>

  <% if logged_in? %>
    <div style="margin: 10px 0;">
      <%= render 'bookmarks/button', recipe: @recipe %>
    </div>
  <% end %>

  <% if @recipe.image.attached? %>
    <div style="margin: 20px 0;">
      <%= image_tag @recipe.image, style: "max-width: 400px; border-radius: 8px;" %>
    </div>
  <% end %>

  <div style="margin: 20px auto; max-width: 600px; text-align: left; background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
    <p><strong>説明:</strong><br>
      <%= @recipe.description %>
    </p>

    <p><strong>おすすめのワイン:</strong><br>
      種類: <%= {'red' => '赤ワイン', 'white' => '白ワイン', 'rose' => 'ロゼワイン'}[@recipe.wine_type] %><br>
      重さ: <%= {'light' => 'ライトボディ', 'medium' => 'ミディアムボディ', 'full' => 'フルボディ'}[@recipe.wine_body] %>
    </p>

    <p><strong>使われている食材:</strong><br>
      <% @recipe.tags.each do |tag| %>
        <span style="display: inline-block; background-color: #e2e3e5; padding: 5px 10px; border-radius: 15px; margin-right: 5px; font-size: 14px;">
          <%= tag.name %>
        </span>
      <% end %>
    </p>
  </div>

  <div style="margin-top: 30px;">
    <% if current_user&.admin? %>
      <%= link_to 'レシピを編集する（画像追加）', edit_recipe_path(@recipe), style: "display: inline-block; margin-bottom: 15px; padding: 10px 20px; background-color: #28a745; color: white; text-decoration: none; border-radius: 5px;" %><br>
    <% end %>

    <%= link_to '検索結果に戻る', "javascript:history.back()" %> |
    <%= link_to 'トップページ', root_path %>
  </div>
</div>