<div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-100 my-10 p-8 sm:p-10">
  
  <div class="text-center mb-8 border-b border-gray-100 pb-6">
    <span class="text-4xl block mb-2">🛠</span>
    <h2 class="text-2xl font-bold text-gray-800">レシピの編集・画像アップロード</h2>
    <p class="text-sm text-gray-500 mt-2">料理の魅力が伝わる画像をセットしましょう。</p>
  </div>

  <%= form_with model: @recipe, local: true, class: "space-y-6" do |f| %>
    
    <div class="bg-red-50 p-6 rounded-xl border border-red-100">
      <%= f.label :image, '📷 料理の画像', class: "block font-bold text-red-800 mb-3" %>
      <%= f.file_field :image, accept: "image/*", class: "w-full text-sm text-gray-600 file:cursor-pointer file:mr-4 file:py-2.5 file:px-5 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-red-800 file:text-white hover:file:bg-red-700 transition" %>
      <p class="text-xs text-red-600 mt-2">※ここから画像をアップロードしてください</p>
    </div>

    <div>
      <%= f.label :title, 'レシピ名', class: "block font-bold text-gray-700 mb-2" %>
      <%= f.text_field :title, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white" %>
    </div>

    <div>
      <%= f.label :description, '説明', class: "block font-bold text-gray-700 mb-2" %>
      <%= f.text_area :description, rows: 5, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white leading-relaxed" %>
    </div>

    <div class="text-center pt-6">
      <%= f.submit 'レシピを更新する', class: "w-full sm:w-auto px-10 py-3.5 bg-gray-800 text-white font-bold rounded-xl hover:bg-gray-700 transition shadow-sm cursor-pointer text-lg" %>
    </div>
  <% end %>

  <div class="mt-8 text-center pt-6 border-t border-gray-100">
    <%= link_to recipe_path(@recipe), class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800 font-medium transition" do %>
      <span>←</span> 詳細画面に戻る
    <% end %>
  </div>
  
</div>