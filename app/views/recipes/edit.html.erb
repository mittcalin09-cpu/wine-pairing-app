<div style="text-align: center; margin-top: 50px;">
  <h2>レシピの編集・画像アップロード</h2>

  <div style="margin: 30px auto; max-width: 500px; text-align: left; background-color: #f8f9fa; padding: 20px; border-radius: 8px;">
    <%= form_with model: @recipe, local: true do |f| %>
      
      <div style="margin-bottom: 20px;">
        <%= f.label :image, '料理の画像 (ここからアップロード!)', style: "font-weight: bold; color: #dc3545;" %><br>
        <%= f.file_field :image, accept: "image/*" %>
      </div>

      <div style="margin-bottom: 15px;">
        <%= f.label :title, 'レシピ名' %><br>
        <%= f.text_field :title, style: "width: 100%;" %>
      </div>

      <div style="margin-bottom: 15px;">
        <%= f.label :description, '説明' %><br>
        <%= f.text_area :description, style: "width: 100%; height: 100px;" %>
      </div>

      <div style="text-align: center; margin-top: 20px;">
        <%= f.submit '更新する', style: "padding: 10px 20px; font-size: 16px;" %>
      </div>
    <% end %>
  </div>

  <%= link_to '詳細画面に戻る', recipe_path(@recipe) %>
</div>