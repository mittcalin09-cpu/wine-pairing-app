<div class="max-w-md mx-auto bg-white rounded-2xl shadow-sm border border-gray-100 my-16 p-8 sm:p-10">
  
  <div class="text-center mb-8">
    <span class="text-4xl block mb-3">✨</span>
    <h2 class="text-2xl font-bold text-gray-800">ユーザー登録</h2>
    <p class="text-sm text-gray-500 mt-2">アカウントを作成して、<br>あなただけのワインペアリング手帳を始めましょう。</p>
  </div>

  <%# 修正ポイント: form_withを1つにまとめました %>
  <%= form_with model: @user, local: true, class: "space-y-5" do |f| %>
    
    <%# ====== エラーメッセージ表示 ====== %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg shadow-sm">
        <div class="flex">
          <div class="flex-shrink-0 text-red-500">
            ⚠️
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-bold text-red-800">
              登録に失敗しました（<%= @user.errors.count %>件のエラー）
            </h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <%# ====== ここまで ====== %>

    <div>
      <%= f.label :name, 'お名前', class: "block font-bold text-gray-700 mb-1.5 text-sm" %>
      <%= f.text_field :name, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white", placeholder: "ワイン 太郎" %>
    </div>

    <div>
      <%= f.label :email, 'メールアドレス', class: "block font-bold text-gray-700 mb-1.5 text-sm" %>
      <%= f.email_field :email, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white", placeholder: "wine@example.com" %>
    </div>

    <div>
      <%= f.label :password, 'パスワード', class: "block font-bold text-gray-700 mb-1.5 text-sm" %>
      <%= f.password_field :password, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white", placeholder: "••••••••" %>
    </div>

    <div>
      <%= f.label :password_confirmation, 'パスワード（確認用）', class: "block font-bold text-gray-700 mb-1.5 text-sm" %>
      <%= f.password_field :password_confirmation, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white", placeholder: "••••••••" %>
    </div>

    <div class="pt-4">
      <%= f.submit 'アカウントを作成する', class: "w-full px-6 py-3.5 bg-red-800 text-white font-bold rounded-xl hover:bg-red-700 transition shadow-sm cursor-pointer text-base" %>
    </div>
    
  <% end %>

  <div class="mt-8 text-center pt-6 border-t border-gray-100">
    <p class="text-sm text-gray-600">
      すでにアカウントをお持ちですか？<br>
      <%= link_to 'ログインはこちら', login_path, class: "text-red-800 font-semibold hover:underline transition mt-2 inline-block" %>
    </p>
  </div>

</div>