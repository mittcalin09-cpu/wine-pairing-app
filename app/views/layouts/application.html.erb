<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wine Pairing App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <header style="text-align: right; padding: 20px; background-color: #f8f9fa;">
  <% if logged_in? %>
    <span><%= link_to 'マイページ', mypage_path %></span> |
    <span>ユーザー: <%= link_to current_user.name, edit_profile_path %></span> |
    <%= link_to 'ログアウト', logout_path, data: { turbo_method: :delete } %>
  <% else %>
    <%= link_to 'ユーザー登録', new_user_path %> |
    <%= link_to 'ログイン', login_path %>
  <% end %>
</header>

<% if flash[:notice] %>
  <div style="color: green; text-align: center; margin-top: 10px;"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div style="color: red; text-align: center; margin-top: 10px;"><%= flash[:alert] %></div>
<% end %>
    <%= yield %>
  </body>
</html>
