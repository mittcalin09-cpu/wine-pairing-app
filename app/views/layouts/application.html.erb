<!DOCTYPE html>
<html>
  <head>
    <title>Wine Pairing App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

   <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-800 font-sans">
    
    <header class="bg-red-900 text-white px-6 py-4 flex justify-between items-center shadow-md">
      <div class="text-xl font-bold tracking-wider">
        <%= link_to '🍷 Wine Pairing', root_path, class: "hover:text-red-200 transition duration-300" %>
      </div>
      
      <div class="space-x-4 text-sm font-medium">
        <% if logged_in? %>
          <%= link_to 'マイページ', mypage_path, class: "hover:text-red-200 transition duration-300" %>
          <span class="opacity-50">|</span>
          <%= link_to current_user.name, edit_profile_path, class: "hover:text-red-200 transition duration-300" %>
          <span class="opacity-50">|</span>
          <%= link_to 'ログアウト', logout_path, data: { turbo_method: :delete }, class: "hover:text-red-200 transition duration-300" %>
        <% else %>
          <%= link_to 'ユーザー登録', new_user_path, class: "hover:text-red-200 transition duration-300" %>
          <span class="opacity-50">|</span>
          <%= link_to 'ログイン', login_path, class: "hover:text-red-200 transition duration-300" %>
        <% end %>
      </div>
    </header>

    <main class="container mx-auto px-4 py-8">
      <% if notice %>
        <p class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 text-center"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-center"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>

  </body>
</html>