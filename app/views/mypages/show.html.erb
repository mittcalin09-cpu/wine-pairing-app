<div style="text-align: center; margin-top: 50px;">
  <h2>マイページ</h2>
  <p><%= current_user.name %> さんのお気に入りレシピ一覧</p>

  <div style="margin-top: 30px;">
    <% if @bookmark_recipes.present? %>
      <ul style="list-style: none; padding: 0; max-width: 500px; margin: 0 auto; text-align: left;">
        <% @bookmark_recipes.each do |recipe| %>
          <li style="padding: 15px; background-color: #f8f9fa; border-radius: 8px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center;">
            <%= link_to recipe.title, recipe_path(recipe), style: "font-size: 18px; font-weight: bold; color: #333; text-decoration: none;" %>
            
            <%= render 'bookmarks/button', recipe: recipe %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p style="color: #6c757d;">お気に入り登録されたレシピはまだありません。</p>
    <% end %>
  </div>

  <div style="margin-top: 40px;">
    <%= link_to 'トップページに戻る', root_path %>
  </div>
</div>