<div style="text-align: center; margin-top: 50px;">
  <h2>ログイン</h2>

  <%= form_with url: login_path, method: :post do |f| %>
    <div style="margin-bottom: 15px;">
      <%= f.label :email, 'メールアドレス' %><br>
      <%= f.email_field :email %>
    </div>

    <div style="margin-bottom: 15px;">
      <%= f.label :password, 'パスワード' %><br>
      <%= f.password_field :password %>
    </div>

    <div>
      <%= f.submit 'ログイン' %>
    </div>
  <% end %>
</div>