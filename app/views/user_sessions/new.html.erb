<div class="max-w-md mx-auto bg-white rounded-2xl shadow-sm border border-gray-100 my-16 p-8 sm:p-10">
  
  <div class="text-center mb-8">
    <span class="text-4xl block mb-3">🍷</span>
    <h2 class="text-2xl font-bold text-gray-800">ログイン</h2>
    <p class="text-sm text-gray-500 mt-2">おかえりなさい！<br>お気に入りのワインレシピをチェックしましょう。</p>
  </div>

  <%= form_with url: login_path, method: :post, class: "space-y-6" do |f| %>
    
    <div>
      <%= f.label :email, 'メールアドレス', class: "block font-bold text-gray-700 mb-2 text-sm" %>
      <%= f.email_field :email, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white", placeholder: "wine@example.com" %>
    </div>

    <div>
      <%= f.label :password, 'パスワード', class: "block font-bold text-gray-700 mb-2 text-sm" %>
      <%= f.password_field :password, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-800 focus:border-transparent transition bg-gray-50 focus:bg-white", placeholder: "••••••••" %>
    </div>

    <div class="pt-2">
      <%= f.submit 'ログインする', class: "w-full px-6 py-3.5 bg-red-800 text-white font-bold rounded-xl hover:bg-red-700 transition shadow-sm cursor-pointer text-base" %>
    </div>
    
  <% end %>

  <div class="mt-8 text-center pt-6 border-t border-gray-100">
    <p class="text-sm text-gray-600">
      アカウントをお持ちでないですか？<br>
      <%= link_to '新規ユーザー登録はこちら', new_user_path, class: "text-red-800 font-semibold hover:underline transition mt-2 inline-block" %>
    </p>
  </div>

</div>